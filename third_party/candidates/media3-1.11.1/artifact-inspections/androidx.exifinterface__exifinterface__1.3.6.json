  "source_special_attributions": [
    {
      "archive": "exifinterface-1.3.6-sources.jar",
      "entry": "androidx/exifinterface/media/ExifInterface.java",
      "sha256": "fd15529ee6ebdfef821de0239996ea99387b42d64152dabac2bf87e8ada5e9c4",
      "bytes": 353348,
      "hits": [
        {
          "line": 2,
          "text": "* Copyright 2018 The Android Open Source Project"
        },
        {
          "line": 4,
          "text": "* Licensed under the Apache License, Version 2.0 (the \"License\");"
        },
        {
          "line": 542,
          "text": "*  <p>Copyright information. In this standard the tag is used to indicate both the photographer"
        },
        {
          "line": 543,
          "text": "*  and editor copyrights. It is the copyright notice of the person or organization claiming"
        },
        {
          "line": 544,
          "text": "*  rights to the image. The Interoperability copyright statement including date and rights"
        },
        {
          "line": 545,
          "text": "*  should be written in this field; e.g., \"Copyright, John Smith, 19xx. All rights reserved.\""
        },
        {
          "line": 546,
          "text": "*  In this standard the field records both the photographer and editor copyrights, with each"
        },
        {
          "line": 548,
          "text": "*  the photographer and editor copyrights, these are to be written in the order of photographer"
        },
        {
          "line": 549,
          "text": "*  followed by editor copyright, separated by NULL (in this case, since the statement also ends"
        },
        {
          "line": 550,
          "text": "*  with a NULL, there are two NULL codes) (see example 1). When only the photographer copyright"
        },
        {
          "line": 551,
          "text": "*  is given, it is terminated by one NULL code (see example 2). When only the editor copyright"
        },
        {
          "line": 552,
          "text": "*  is given, the photographer copyright part consists of one space followed by a terminating"
        },
        {
          "line": 553,
          "text": "*  NULL code, then the editor copyright is given (see example 3). When the field is left blank,"
        },
        {
          "line": 556,
          "text": "*  <p>Ex. 1) When both the photographer copyright and editor copyright are given."
        },
        {
          "line": 557,
          "text": "*  <ul><li>Photographer copyright + NULL + editor copyright + NULL</li></ul></p>"
        },
        {
          "line": 558,
          "text": "*  <p>Ex. 2) When only the photographer copyright is given."
        },
        {
          "line": 559,
          "text": "*  <ul><li>Photographer copyright + NULL</li></ul></p>"
        },
        {
          "line": 560,
          "text": "*  <p>Ex. 3) When only the editor copyright is given."
        },
        {
          "line": 561,
          "text": "*  <ul><li>Space ({@code 0x20}) + NULL + editor copyright + NULL</li></ul></p>"
        },
        {
          "line": 569,
          "text": "public static final String TAG_COPYRIGHT = \"Copyright\";"
        },
        {
          "line": 603,
          "text": "*  Normally {@link #COLOR_SPACE_S_RGB} is used to define the color space based on the PC"
        },
        {
          "line": 1773,
          "text": "*  <p>Indicates the altitude based on the reference in {@link #TAG_GPS_ALTITUDE_REF}."
        },
        {
          "line": 3560,
          "text": "new ExifTag(TAG_COPYRIGHT, 33432, IFD_FORMAT_STRING),"
        },
        {
          "line": 3729,
          "text": "new ExifTag(TAG_COPYRIGHT, 33432, IFD_FORMAT_STRING),"
        },
        {
          "line": 4015,
          "text": "* Reads Exif tags from the specified image input stream based on the stream type. Attribute"
        },
        {
          "line": 4885,
          "text": "* Creates and returns a Bitmap object of the thumbnail image based on the byte array and the"
        },
        {
          "line": 6464,
          "text": "// the following order based on type (if they exist):"
        },
        {
          "line": 6474,
          "text": "// Based on these rules, this API will support three different cases depending on the contents"
        },
        {
          "line": 7058,
          "text": "// Sets thumbnail offset & length attributes based on JpegInterchangeFormat or StripOffsets tags"
        },
        {
          "line": 7261,
          "text": "// Swap images based on size (primary > preview > thumbnail)"
        },
        {
          "line": 8019,
          "text": "// Swaps image data based on image size"
        }
      ]
    },
