+            val cancelUntil = System.nanoTime() + TimeUnit.SECONDS.toNanos(3)
+            while (cancel.state != Thread.State.BLOCKED && System.nanoTime() < cancelUntil) Thread.yield()
+            assertEquals(Thread.State.BLOCKED, cancel.state)
